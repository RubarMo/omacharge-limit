#!/usr/bin/env bash
# Root-owned write helper for the rubar.omacharge-limit bar widget.
# Installed to /usr/local/bin/charge-limit-apply (root:root 0755) by
# tools/install-helper.sh. Invoked via passwordless sudo from the shell:
#   sudo -n /usr/local/bin/charge-limit-apply <check|saver|full>
#
# Writes only the charge-threshold sysfs files of the first battery that
# exposes them; arguments are strictly validated; nothing else runs as root.
#
# Design notes:
#   * The kernel rejects a threshold write that would leave start >= end,
#     so before lowering end the helper first drops a conflicting start
#     threshold. In the common case ONLY the end threshold is written —
#     one EC transaction per mode change.
#   * The EC churns for a moment after a write and can report stale values;
#     the helper therefore does NOT read back after a successful write pass
#     (polling a busy EC stalls the kernel and, on ThinkPads, EC-sourced
#     input). Verification is left to the widget's regular polling.
#   * CHARGE_LIMIT_SYSFS overrides the power_supply root (testing only;
#     sudo scrubs the environment, so it is inert for the privileged
#     invocation).

set -euo pipefail
trap 'exit 143' TERM INT

SYSFS_ROOT="${CHARGE_LIMIT_SYSFS:-/sys/class/power_supply}"

BAT=""
for candidate in "$SYSFS_ROOT"/BAT*; do
  if [[ -f "$candidate/charge_control_end_threshold" ]]; then
    BAT="$candidate"
    break
  fi
done

if [[ -z "$BAT" ]]; then
  echo "charge-limit-apply: no supported battery found" >&2
  exit 1
fi

END_FILE="$BAT/charge_control_end_threshold"
START_FILE="$BAT/charge_control_start_threshold"

if (($# != 1)); then
  echo "usage: charge-limit-apply <check|saver|full>" >&2
  exit 2
fi

case "$1" in
  check) : ;;
  saver) TARGET_END=80 ;;
  full)  TARGET_END=100 ;;
  *) echo "charge-limit-apply: mode must be check, saver or full" >&2; exit 2 ;;
esac

MODE="$1"

read_pair() {
  local end start
  end="$(<"$END_FILE")" || return 1
  start="$(<"$START_FILE")" || return 1
  [[ "$end" =~ ^[0-9]+$ && "$start" =~ ^[0-9]+$ ]] || return 1
  printf '%s %s\n' "$end" "$start"
}

# One write pass from a fresh read. Returns non-zero when a needed write
# was rejected by the kernel/EC.
write_pass() {
  local cur cur_end cur_start
  cur="$(read_pair)" || return 1
  cur_end="${cur%% *}"; cur_start="${cur##* }"

  if (( cur_start >= TARGET_END )); then
    # A conflicting start threshold must drop before end can.
    (( cur_start == 75 )) || { echo "75" > "$START_FILE" || return 1; }
  fi
  (( cur_end == TARGET_END )) || { echo "$TARGET_END" > "$END_FILE" || return 1; }
  return 0
}

if [[ "$MODE" == "check" ]]; then
  if cur="$(read_pair)"; then
    echo "end=${cur%% *} start=${cur##* }"
    exit 0
  fi
  echo "charge-limit-apply: cannot read $BAT thresholds" >&2
  exit 1
fi

# A rejection means the fresh read raced an in-flight EC transaction; give
# it a second to settle, re-read and recompute. Verification of the final
# state is deliberately NOT done here (see design notes).
for ((attempt = 1; attempt <= 3; attempt++)); do
  if write_pass; then
    exit 0
  fi
  sleep 1
done

echo "charge-limit-apply: could not write $MODE thresholds on $BAT" >&2
exit 1
